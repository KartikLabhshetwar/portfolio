---
import { projects } from '../data/projects';
---
<ul class="mt-10 flex flex-col gap-3" aria-label="Projects">
  {projects.map((project) => (
    <li>
      <a
        href={project.liveLink ?? project.githubLink}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${project.title}: ${project.description}`}
        class="group grid grid-cols-[auto_1fr_auto] items-center gap-3 rounded-sm py-0.5 outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
      >
        <span class="text-foreground group-hover:underline">{project.title}</span>
        <span class="border-t border-border transition-colors group-hover:border-foreground/20" aria-hidden="true"></span>
        <span class="text-sm text-muted-foreground">{project.kind}</span>
      </a>
    </li>
  ))}
</ul>
