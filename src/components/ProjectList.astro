---
import { projects } from '../data/projects';
---
<ul class="project-list page-content" aria-label="Projects">
  {projects.map((project) => (
    <li class="min-w-0">
      <a
        href={project.liveLink ?? project.githubLink}
        target="_blank"
        rel="noopener noreferrer"
        class="project-row group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4 focus-visible:ring-offset-background"
      >
        <div class="project-preview aspect-video overflow-hidden rounded-lg border border-border bg-muted">
          {project.image ? (
            <img
              src={project.image}
              alt=""
              width="800"
              height="450"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-contain"
            />
          ) : (
            <div class="flex h-full items-center justify-center p-6" aria-hidden="true">
              <span class="text-center text-2xl font-medium tracking-tight text-muted-foreground">{project.title}</span>
            </div>
          )}
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-3">
            <h2 class="text-base font-normal leading-6 tracking-tight text-foreground">{project.title}</h2>
            <span class="text-xs text-muted-foreground">{project.kind}</span>
            <span aria-hidden="true" class="project-arrow ml-auto text-lg text-muted-foreground group-hover:text-foreground group-focus-visible:text-foreground">↗</span>
          </div>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">{project.description}</p>
          {project.impact && <p class="mt-3 text-xs leading-5 text-muted-foreground">{project.impact}</p>}
          <span class="sr-only">Opens in a new tab</span>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .project-list > li + li { border-top: 1px solid var(--border); }
  .project-list > li:first-child .project-row { padding-top: 0; }
  .project-row {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 1.5rem;
    border-radius: 0.25rem;
  }
  @media (min-width: 640px) {
    .project-row { grid-template-columns: 10rem minmax(0, 1fr); gap: 1.25rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .project-arrow { transition: transform 180ms ease-out; }
    .project-row:is(:hover, :focus-visible) .project-arrow { transform: translate(2px, -2px); }
  }
</style>
