---
interface Props { title: string; description: string; pubDate: Date; slug: string; }
const { title, description, slug } = Astro.props;
---
<a href={`/blog/${slug}`} class="group flex flex-col rounded-md ring-offset-2">
  <p class="text-foreground underline decoration-transparent underline-offset-4 transition-[text-decoration-color] group-hover:decoration-foreground/30 group-focus-visible:decoration-foreground/30">{title}</p>
  <p class="text-muted-foreground">{description}</p>
</a>
