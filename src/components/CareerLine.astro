---
import { experience } from '../data/experience';

const current = experience.find((company) => company.isCurrentEmployer)!;
const previous = experience.find((company) => company.id === 'turboml')!;
---
<p class="mt-5 max-w-[34rem] text-sm leading-6 text-muted-foreground">
  <a href="/work" class="currently-link">Currently</a> a <span class="text-foreground">{current.positions[0].title}</span> at
  <a href={current.companyWebsite} target="_blank" rel="noopener noreferrer" class="ml-0.5 inline-flex items-center gap-1.5 rounded-full bg-muted px-1.5 py-0.5 text-foreground hover:bg-accent">
    <img src={current.companyLogo} alt="" class="size-4 rounded-full" />
    {current.companyName}
  </a>, building memory infrastructure for AI agents. Previously a
  <span class="text-foreground">{previous.positions[0].title}</span> at
  <a href={previous.companyWebsite} target="_blank" rel="noopener noreferrer" class="ml-0.5 inline-flex items-center gap-1.5 rounded-full bg-muted px-1.5 py-0.5 text-foreground hover:bg-accent">
    <img src={previous.companyLogo} alt="" class="size-4 rounded-full" />
    {previous.companyName}
  </a>.
</p>

<style>
  .currently-link {
    cursor: pointer;
    color: var(--foreground);
    background: linear-gradient(color-mix(in srgb, var(--signal) 12%, transparent)) bottom / 100% 0 no-repeat;
    box-shadow: inset 0 -0.14em color-mix(in srgb, var(--signal) 45%, transparent);
    transition: background-size 200ms ease-out, box-shadow 200ms ease-out;
  }

  .currently-link:hover,
  .currently-link:focus-visible {
    background-size: 100% 100%;
    box-shadow: inset 0 -0.14em var(--signal);
  }

  @media (prefers-reduced-motion: reduce) {
    .currently-link {
      transition: none;
    }
  }
</style>
