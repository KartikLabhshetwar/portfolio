---
import { experience } from '../data/experience';

const month = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const formatDate = (value: string) => {
  const [part, year] = value.split('.');
  return year ? month.format(new Date(Date.UTC(Number(year), Number(part) - 1))) : value;
};
const companyPeriod = (positions: (typeof experience)[number]['positions']) => {
  const first = positions.at(-1)!;
  const current = positions.find((position) => !position.employmentPeriod.end);
  return `${formatDate(first.employmentPeriod.start)} to ${current ? 'Present' : formatDate(positions[0].employmentPeriod.end!)}`;
};
---
<section class="flex flex-col gap-4">
  <p class="text-muted-foreground">Companies</p>
  <ul class="-mx-3 flex flex-col gap-2">
    {experience.map((company) => (
      <li>
        <a
          href={company.companyWebsite}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Visit ${company.companyName}`}
          class="group flex cursor-pointer items-start gap-3 rounded-xl px-3 py-2 transition-colors duration-200 hover:bg-muted active:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          <img src={company.companyLogo} alt="" class="size-7 rounded-full" />
          <div class="min-w-0 flex-1">
            <div class="grid grid-cols-[auto_1fr_auto] items-center gap-3">
              <span class="text-foreground">{company.companyName}</span>
              <span class="border-t border-border transition-colors group-hover:border-foreground/20" aria-hidden="true"></span>
              <span class="flex items-center gap-1.5 text-sm tabular-nums text-muted-foreground">
                {companyPeriod(company.positions)}
                <span aria-hidden="true" class="opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">↗</span>
              </span>
            </div>
            <ul class="mt-2 flex flex-col gap-1.5">
              {company.positions.map((position) => (
                <li class="flex flex-col justify-between gap-x-4 text-sm sm:flex-row">
                  <span class="text-foreground/80">{position.title}</span>
                  <span class="shrink-0 tabular-nums text-muted-foreground">
                    {formatDate(position.employmentPeriod.start)} to {position.employmentPeriod.end ? formatDate(position.employmentPeriod.end) : 'Present'}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
