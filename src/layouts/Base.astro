---
import '../styles/global.css';
import { ClientRouter, fade } from 'astro:transitions';
import CommandMenu from '../components/CommandMenu.tsx';
import { minimalButtonClassName } from '../components/evil-buttons/minimal';
import { cn } from '../lib/utils';
import { AutoTOCMinimap } from '../components/auto-toc-minimap';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { experience } from '../data/experience';
import { getCollection } from 'astro:content';
import { serializeJsonLd, structuredData } from '../lib/structured-data';
// `toc` selects which headings become scroll-minimap ticks (section h2s by default).
// `image` is the social card; pages (e.g. blog posts) can pass their own.
// `schemaType`/`datePublished` shape the page's JSON-LD node.
const {
  title = profile.name,
  description = 'Open-source apps, developer tools, and notes on building software.',
  image = '/og-profile.png',
  ogType = 'website',
  toc = 'main h2',
  schemaType,
  datePublished,
  wide = false,
  noindex = false,
} = Astro.props;
const siteName = profile.name;
// Always point canonical at the configured production domain (Astro.site),
// so a workers.dev or any mirror host can't compete for ranking.
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(pathname, Astro.site ?? Astro.url).href;
// Social scrapers need an absolute image URL.
const ogImage = new URL(image, Astro.site ?? Astro.url).href;
// worksFor comes from the experience data rather than a second copy of it, so
// a job change updates the schema too.
const current = experience.find((e) => e.isCurrentEmployer);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime() || a.data.title.localeCompare(b.data.title));
const supportingPages = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
const footerSocials = ['LinkedIn', 'X', 'GitHub'].map((label) => profile.socials.find((social) => social.label === label)!);
const meeting = profile.socials.find((social) => social.label === 'Book a call')!;
const email = profile.socials.find((social) => social.label === 'Email')!;
const footerButtonClassName = cn(minimalButtonClassName, 'min-h-11 shrink-0 whitespace-nowrap px-1 text-xs min-[360px]:px-2 sm:min-h-9 sm:px-3 sm:text-sm');
const navigation = [
  { href: '/', label: 'Home', icon: 'M3 10a2 2 0 0 1 .75-1.56l7-5.6a2 2 0 0 1 2.5 0l7 5.6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2h-5v-7h-4v7H5a2 2 0 0 1-2-2Z' },
  { href: '/experience', label: 'Experience', icon: 'M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2 M3 7h18v13H3Z M3 11a20 20 0 0 0 18 0 M10 12v3h4v-3' },
  { href: '/projects', label: 'Projects', icon: 'M3 9V5a1 1 0 0 1 1-1h5l2 3h9a1 1 0 0 1 1 1v2 M3 20h16l3-10H6Z' },
  { href: '/blog', label: 'Writing', icon: 'M12 20h9 M16.5 3.5a2.12 2.12 0 0 1 3 3L9 17l-4 1 1-4Z M15 5l3 3' },
  { href: '/newsletter', label: 'Subscribe', icon: 'M3 5h18v14H3Z M3 6l9 7 9-7' },
];
const breadcrumbs = pathname === '/' || noindex ? [] : [
  navigation[0],
  ...(pathname.startsWith('/blog/') ? [navigation.find((link) => link.href === '/blog')!] : []),
  { href: pathname, label: [...navigation, ...supportingPages].find((link) => link.href === pathname)?.label ?? title.split(' | ')[0] },
];
const jsonLd = serializeJsonLd(
  structuredData(
    (Astro.site ?? Astro.url).toString(),
    { ...profile, role: current?.positions[0]?.title ?? profile.role, employer: current && { name: current.companyName, url: current.companyWebsite } },
    {
      url: canonical,
      title,
      description,
      image: ogImage,
      type: schemaType,
      datePublished,
      breadcrumbs,
    },
  ),
);
const commandItems = [
  ...navigation.map(({ href, label }) => ({ href, label, group: 'Pages' })),
  ...supportingPages.map((l) => ({ label: l.label, href: l.href, group: 'Pages' })),
  ...projects.map((p) => ({
    label: p.title,
    href: p.liveLink ?? p.githubLink ?? '/projects',
    group: 'Projects',
    external: true,
    keywords: [p.description, p.impact].filter(Boolean) as string[],
  })),
  ...posts.map((p) => ({
    label: p.data.title,
    href: `/blog/${p.id.replace(/\/index$/, '')}`,
    group: 'Writing',
    keywords: [p.data.description],
  })),
  ...profile.socials.map((s) => ({ label: s.label, href: s.href, group: 'Links', external: true })),
];
---
<!doctype html>
<html lang="en" transition:name="root" transition:animate={fade({ duration: '0.18s' })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <ClientRouter fallback="swap" />
    <script>
      import { navigate } from 'astro:transitions/client';

      const isLegacyProjects = (url: URL) =>
        url.origin === location.origin &&
        ['/experience', '/work'].includes(url.pathname.replace(/\/+$/, '')) &&
        url.hash === '#projects';

      document.addEventListener('astro:before-preparation', (event) => {
        if (isLegacyProjects(event.to)) {
          event.to = new URL(`/projects${event.to.search}`, event.to);
        }
      });
      const redirectLegacyProjects = () => {
        if (isLegacyProjects(new URL(location.href))) {
          const target = `/projects${location.search}`;
          // Browser-created hash entries have no router state. Initialize a new document
          // for those old links so back/forward navigation remains valid.
          if (!history.state) return location.replace(target);
          void navigate(target, { history: 'replace' });
        }
      };
      document.addEventListener('astro:page-load', redirectLegacyProjects);
      window.addEventListener('hashchange', redirectLegacyProjects);

      document.addEventListener('astro:before-swap', (event) => {
        // A newer navigation can skip the previous transition's visual snapshot.
        void event.viewTransition.ready.catch(() => {});
        const dark = document.documentElement.classList.contains('dark');
        event.newDocument.documentElement.classList.toggle('dark', dark);
        event.newDocument.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      });
    </script>
    <slot name="head" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && <link rel="alternate" type="text/markdown" href={canonical} title="Markdown (send Accept: text/markdown)" />}
    {!noindex && <script type="application/ld+json" is:inline set:html={jsonLd}></script>}

    <!-- Open Graph (LinkedIn, Discord, Slack, Facebook) -->
    <meta property="og:type" content={ogType} />
    {datePublished && <meta property="article:published_time" content={datePublished} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@code_kartik" />
    <meta name="twitter:creator" content="@code_kartik" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <script is:inline>
      const t = localStorage.getItem('theme');
      const dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <main class:list={["mx-auto flex min-h-svh w-full grow flex-col justify-center px-5 pt-8 pb-32 sm:px-4 sm:pt-16", wide ? "max-w-2xl" : "max-w-lg"]}>
      {toc && <div class="fixed top-1/2 right-2 z-40 hidden -translate-y-1/2 xl:block">
        <!-- client:idle, not client:visible: the island renders empty until headings load,
             so a visibility trigger would never fire (zero-size element never intersects). -->
        <AutoTOCMinimap client:idle selector={toc} />
      </div>}
      {breadcrumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-7 text-xs leading-6 text-muted-foreground sm:mb-9">
          <ol class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
            {breadcrumbs.map((crumb, index) => (
              <li class="inline-flex min-w-0 items-baseline gap-2">
                {index > 0 && <span aria-hidden="true" class="text-muted-foreground/60">/</span>}
                {index === breadcrumbs.length - 1
                  ? <span aria-current="page" class="break-words text-foreground">{crumb.label}</span>
                  : <a href={crumb.href} class="hover:text-foreground hover:underline">{crumb.label}</a>}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
      <footer class="mt-8 border-t border-border pt-5 sm:mt-10">
        <nav aria-label="Elsewhere" class="flex items-center gap-1 sm:gap-2">
          <a href={email.href} class={footerButtonClassName}>Email</a>
          <a href={meeting.href} target="_blank" rel="noopener noreferrer" class={footerButtonClassName}>Book a meet</a>
          {footerSocials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class={footerButtonClassName}>{s.label}</a>
          ))}
        </nav>
      </footer>
    </main>
    <nav aria-label="Main navigation" class="page-dock" transition:name="page-dock" transition:animate="none">
      {navigation.map((link) => {
        const current = pathname === link.href ? 'page' : link.href === '/blog' && pathname.startsWith('/blog/') ? 'location' : undefined;
        return (
          <a href={link.href} aria-current={current} aria-label={link.label}>
            {current && <span class="dock-selection" aria-hidden="true" />}
            <svg transition:name={`dock-icon-${link.label.toLowerCase()}`} transition:animate="none" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={link.icon} />
            </svg>
            <span class="dock-label" aria-hidden="true">{link.label}</span>
          </a>
        );
      })}
    </nav>
    <CommandMenu client:idle items={commandItems} transition:persist />
  </body>
</html>
