---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import NewsletterSubscribe from '../components/NewsletterSubscribe.astro';
import { minimalButtonClassName } from '../components/evil-buttons/minimal';

export const prerender = false;
---
<Base title="Newsletter | Kartik Labhshetwar" description="Get Kartik Labhshetwar's latest writing about software, AI systems, and building projects by email through Substack. Free to subscribe. Unsubscribe anytime.">
  <PageHeader title="Newsletter" description="New posts, straight to your inbox." />
  <div class="page-content flex flex-col items-start gap-4">
    <p class="text-sm leading-6 text-muted-foreground">I write about software, AI systems, and what I learn building projects. Subscribe on Substack to get new posts by email.</p>
    <NewsletterSubscribe />
    <p class="text-sm leading-6 text-muted-foreground">
      <a href="/privacy" class="underline underline-offset-4">Privacy details</a>.
    </p>
    <a href="/blog" class={minimalButtonClassName}>Read the latest posts</a>
  </div>
</Base>
