---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { experience } from '../data/experience';

// On demand so the Accept-negotiation middleware runs (see src/middleware.ts).
export const prerender = false;

const current = experience.find((e) => e.isCurrentEmployer);
const currentTitle = current?.positions[0]?.title;
const shipped = projects.length;
const withImpact = projects.filter((p) => p.impact && p.impact !== 'Latest').length;
---
<Base
  title="About — Kartik Labhshetwar"
  description="Kartik Labhshetwar is a software engineer at Mem0 in India, building the memory layer for AI agents and shipping open-source developer tools."
  schemaType="ProfilePage"
>
  <h1 class="text-2xl font-semibold tracking-tight">About</h1>
  <p class="mt-3 max-w-prose text-sm leading-relaxed text-foreground/75">
    I'm {profile.name}, a software engineer based in {profile.location}. I'm a {currentTitle} at {current?.companyName},
    where I build the universal memory layer for AI agents: SDKs in Python and TypeScript, the self-hosted
    server, vector-store integrations, editor plugins, and the CLI. Outside of that I ship my own products,
    mostly small tools that solve a problem I hit myself, and write about what I learn doing it.
  </p>

  <h2 class="mt-10 text-xs font-semibold uppercase tracking-wide text-muted-foreground">What I work on</h2>
  <p class="mt-3 max-w-prose text-sm leading-relaxed text-foreground/75">
    Day to day that means memory infrastructure for agents: making retrieval return the right memories instead
    of the closest ones, cutting search latency, hardening a self-hosted server other teams run in production,
    and closing security holes in the vector stores underneath. A lot of the work is open source, so it happens
    in public: reviewing community pull requests, triaging a backlog, and keeping SDK releases moving. Before
    Mem0 I was a software engineering intern at Turbo ML, working on scheduling, messaging integrations, and
    real-time scraping on Next.js, Supabase, and Cloudflare Workers.
  </p>

  <h2 class="mt-10 text-xs font-semibold uppercase tracking-wide text-muted-foreground">What I've built</h2>
  <p class="mt-3 max-w-prose text-sm leading-relaxed text-foreground/75">
    {shipped} projects shipped so far, {withImpact} of them with real users behind them: Screenshot Studio
    (20k+ monthly users), BetterShot, an open-source CleanShot X alternative for macOS (12k+ downloads), Lazy
    Commit, a CLI that writes your git commit messages (195k+ downloads on npm), and OneURL, a self-hostable
    Linktree alternative. Most are open source. I care less about which framework wins an argument and more
    about whether the thing ships and people keep using it.
    <a href="/projects" class="underline underline-offset-4">See all projects</a>.
  </p>

  <h2 class="mt-10 text-xs font-semibold uppercase tracking-wide text-muted-foreground">What I write</h2>
  <p class="mt-3 max-w-prose text-sm leading-relaxed text-foreground/75">
    Experience reports, not tutorials: what retrieval-augmented generation actually is and where it breaks,
    running a text-to-speech system for 25,000 users without melting a server, a working guide to SSH, and how
    I pick problems worth solving. If a post exists it's because I had to figure the thing out first.
    <a href="/blog" class="underline underline-offset-4">Read the blog</a>.
  </p>

  <h2 class="mt-10 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Elsewhere</h2>
  <ul class="mt-3">
    {profile.socials.map((s) => (
      <li class="border-b border-border py-3">
        <a href={s.href} target="_blank" rel="noopener noreferrer" class="text-sm font-medium underline-offset-4 hover:underline">{s.label} ↗</a>
      </li>
    ))}
  </ul>

  <p class="mt-6 max-w-prose text-sm leading-relaxed text-foreground/75">
    The fastest way to reach me is on <a href="/contact" class="underline underline-offset-4">the contact page</a>.
  </p>
</Base>
