---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { experience } from '../data/experience';

export const prerender = false;
const current = experience.find((company) => company.isCurrentEmployer)!;
const featured = projects.filter((project) => ['bettershot', 'screenshot-studio', 'lazycommit'].includes(project.id));
---
<Base title="About | Kartik Labhshetwar" description="Meet Kartik Labhshetwar, a software engineer in India building AI memory infrastructure, apps, and developer tools." schemaType="ProfilePage">
  <PageHeader title="About" description={`I'm ${profile.name}, a software engineer based in ${profile.location}.`} />
  <div class="page-copy">
    <h2>What I work on</h2>
    <p>
      I'm a {current.positions[0].title} at {current.companyName}, building memory infrastructure for AI agents.
      My work spans SDKs, retrieval, editor integrations, and the self-hosted server.
      <a href="/experience">See my experience</a>.
    </p>
    <h2>What I've built</h2>
    <p>I build apps and developer tools for problems I run into. A few of them:</p>
    <ul class="flex flex-col gap-3">
      {featured.map((project) => (
        <li>
          <a href={project.liveLink ?? project.githubLink}>{project.title}</a>
          {project.impact && <span class="text-sm"> · {project.impact}</span>}
          <p>{project.description}</p>
        </li>
      ))}
    </ul>
    <p><a href="/projects">All {projects.length} projects</a>.</p>
    <h2>What I write</h2>
    <p>
      I write about AI systems, infrastructure, and what I learn building software.
      <a href="/blog">Read the latest posts</a> or <a href="/newsletter">get them by email</a>.
    </p>
    <h2>Get in touch</h2>
    <p>For roles, collaborations, or a conversation about something you're building, <a href="/contact">get in touch</a>.</p>
  </div>
</Base>
