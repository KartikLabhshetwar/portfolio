---
import Base from '../layouts/Base.astro';

// On demand so the Accept-negotiation middleware runs and agents asking for
// text/markdown get the Markdown recovery body (see src/middleware.ts).
export const prerender = false;
Astro.response.status = 404;

const links = [
  { href: '/', label: 'Home', note: 'Profile, experience, featured projects, latest posts' },
  { href: '/about', label: 'About', note: 'Who runs this site, and what they work on' },
  { href: '/projects', label: 'Projects', note: 'Everything shipped' },
  { href: '/blog', label: 'Blog', note: 'All posts' },
  { href: '/contact', label: 'Contact', note: 'How to get in touch' },
  { href: '/sponsors', label: 'Sponsors', note: 'GitHub sponsors' },
  { href: '/privacy', label: 'Privacy', note: 'What this site collects' },
  { href: '/llms.txt', label: 'llms.txt', note: 'Structured index of this site, plus when to use it' },
  { href: '/llms-full.txt', label: 'llms-full.txt', note: 'Every page and full post text in one Markdown file' },
  { href: '/sitemap-index.xml', label: 'Sitemap', note: 'Every canonical URL' },
];
---
<Base title="404 — Page not found" description="There is nothing at this URL. Here is where to look instead.">
  <h1 class="text-2xl font-semibold tracking-tight">404 — Page not found</h1>
  <p class="mt-2 max-w-prose text-sm leading-relaxed text-muted-foreground">
    There is nothing at this URL. Here is where to look next.
  </p>

  <h2 class="mt-10 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Where to look next</h2>
  <ul class="mt-3">
    {links.map((l) => (
      <li class="border-b border-border py-3">
        <a href={l.href} class="text-sm font-medium underline-offset-4 hover:underline">{l.label}</a>
        <span class="ml-2 text-sm text-muted-foreground">{l.note}</span>
      </li>
    ))}
  </ul>

  <p class="mt-6 max-w-prose text-xs text-muted-foreground">
    Agents: any page URL also serves Markdown when you send <code>Accept: text/markdown</code>.
  </p>
</Base>
