---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';

// On demand so the Accept-negotiation middleware runs and agents asking for
// text/markdown get the Markdown recovery body (see src/middleware.ts).
export const prerender = false;
Astro.response.status = 404;

const links = [
  { href: '/', label: 'Home', note: 'Profile and latest posts' },
  { href: '/about', label: 'About', note: 'Who runs this site, and what they work on' },
  { href: '/work', label: 'Work', note: 'Companies, roles, and shipped projects' },
  { href: '/blog', label: 'Blog', note: 'All posts' },
  { href: '/contact', label: 'Contact', note: 'How to get in touch' },
  { href: '/privacy', label: 'Privacy', note: 'What this site collects' },
  { href: '/llms.txt', label: 'llms.txt', note: 'Structured index of this site, plus when to use it' },
  { href: '/llms-full.txt', label: 'llms-full.txt', note: 'Every page and full post text in one Markdown file' },
  { href: '/sitemap-index.xml', label: 'Sitemap', note: 'Every canonical URL' },
];
---
<Base title="404 | Page not found" description="There is nothing at this URL. Here is where to look instead." backHref="/">
  <PageHeader title="404 | Page not found" description="There is nothing at this URL. Here is where to look next." />

  <h2 class="mt-11 text-2xl font-semibold">Where to look next</h2>
  <ul class="mt-3 flex flex-col gap-4">
    {links.map((l) => (
      <li>
        <a href={l.href} class="text-base underline-offset-4 hover:underline">{l.label}</a>
        <p class="text-base text-muted-foreground">{l.note}</p>
      </li>
    ))}
  </ul>

  <p class="mt-8 max-w-prose text-sm text-muted-foreground">
    Agents: any page URL also serves Markdown when you send <code>Accept: text/markdown</code>.
  </p>
</Base>
