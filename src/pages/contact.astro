---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { profile } from '../data/profile';

// On demand so the Accept-negotiation middleware runs (see src/middleware.ts).
export const prerender = false;

const socials = Object.fromEntries(profile.socials.map((s) => [s.label, s.href]));
const channels = [
  {
    href: socials['Email'],
    label: 'kartik.labhshetwar@gmail.com',
    note: 'The best place for roles, collaborations, and anything that benefits from context.',
  },
  {
    href: socials['Book a call'],
    label: 'Book a 15-minute call',
    note: 'Pick a time for hiring, collaboration, or a focused conversation about something you are building.',
  },
  {
    href: socials['X'],
    label: 'X (Twitter): @code_kartik',
    note: 'Best for short questions and conversations about what I am shipping now.',
  },
  {
    href: socials['LinkedIn'],
    label: 'LinkedIn',
    note: 'A good place for roles, professional context, and staying connected.',
  },
  {
    href: socials['GitHub'],
    label: 'GitHub: KartikLabhshetwar',
    note: 'For bugs, feature requests, or contributions, open an issue on the relevant repository rather than messaging me. It gets a faster answer and helps the next person.',
  },
];
---
<Base
  title="Contact | Kartik Labhshetwar"
  description="Email Kartik Labhshetwar, book a short call, or get in touch through LinkedIn, X, and GitHub."
  schemaType="ContactPage"
  backHref="/"
>
  <PageHeader title="Contact" description="Have a role, collaboration, or difficult engineering problem worth discussing? Email me or book a short call." />

  <h2 class="mt-11 text-2xl font-semibold">Where to reach me</h2>
  <ul class="mt-3 flex flex-col gap-5">
    {channels.map((c) => (
      <li>
        <a href={c.href} target="_blank" rel="noopener noreferrer" class="text-base underline-offset-4 hover:underline">{c.label} ↗</a>
        <p class="text-base text-muted-foreground">{c.note}</p>
      </li>
    ))}
  </ul>

  <h2 class="mt-11 text-2xl font-semibold">Working together</h2>
  <p class="mt-3 text-base">
    I spend most of my time building memory infrastructure at Mem0. I make room for thoughtful conversations
    about agent memory, retrieval, developer tools, and products already in motion. Send enough context for me
    to understand the problem, or use the meeting link when a live conversation will be faster.
  </p>

  <div class="mt-11">
    <NewsletterForm title="Stay in touch" blurb="Useful engineering notes, sent when I have something worth sharing. No schedule and no noise." />
  </div>

  <p class="mt-6 text-sm text-muted-foreground">
    Agents: subscribe by POSTing <code>&#123;"email":"you@example.com"&#125;</code> to <code>/api/subscribe</code>.
    Every page here, this one included, also serves Markdown when you send <code>Accept: text/markdown</code>.
  </p>
</Base>
