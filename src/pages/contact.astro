---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { profile } from '../data/profile';

// On demand so the Accept-negotiation middleware runs (see src/middleware.ts).
export const prerender = false;

const socials = Object.fromEntries(profile.socials.map((s) => [s.label, s.href]));
const channels = [
  {
    href: socials['Email'],
    label: 'kartik.labhshetwar@gmail.com',
    note: 'The best place for roles, collaborations, and anything that benefits from context.',
  },
  {
    href: socials['Book a call'],
    label: 'Book a 15-minute call',
    note: 'Pick a time for hiring, collaboration, or a focused conversation about something you are building.',
  },
  {
    href: socials['X'],
    label: 'X (Twitter): @code_kartik',
    note: 'Best for short questions and conversations about what I am shipping now.',
  },
  {
    href: socials['LinkedIn'],
    label: 'LinkedIn',
    note: 'A good place for roles, professional context, and staying connected.',
  },
  {
    href: socials['GitHub'],
    label: 'GitHub: KartikLabhshetwar',
    note: 'For bugs, feature requests, or contributions, open an issue on the relevant repository rather than messaging me. It gets a faster answer and helps the next person.',
  },
];
---
<Base
  title="Contact | Kartik Labhshetwar"
  description="Email Kartik Labhshetwar, book a short call, or get in touch through LinkedIn, X, and GitHub."
  schemaType="ContactPage"
  backHref="/"
>
  <PageHeader title="Contact" description="Have a role, collaboration, or difficult engineering problem worth discussing? Email me or book a short call." />

  <h2 class="mt-8 text-base font-normal tracking-tight">Where to reach me</h2>
  <ul class="mt-3 flex flex-col gap-5">
    {channels.map((c) => (
      <li>
        <a href={c.href} target="_blank" rel="noopener noreferrer" class="text-sm underline-offset-4 hover:underline">{c.label} ↗</a>
        <p class="text-sm leading-6 text-muted-foreground">{c.note}</p>
      </li>
    ))}
  </ul>

  <p id="newsletter" class="mt-8 text-sm text-muted-foreground">
    For new posts by email, <a href="/newsletter" class="underline underline-offset-4">subscribe to the newsletter</a>.
  </p>
</Base>
