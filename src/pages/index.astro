---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import BlogCard from '../components/BlogCard.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

export const prerender = false;

const toSlug = (id: string) => id.replace(/\/index$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime() || a.data.title.localeCompare(b.data.title)).slice(0, 4);
---
<Base schemaType="ProfilePage">
  <PageHeader title={profile.name} description={profile.tagline} />

  <section class="mt-8 flex flex-col gap-4 sm:mt-10">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-base font-normal tracking-tight">Writing</h2>
      <a href="/blog" class="ink-link inline-flex min-h-6 items-center text-sm text-muted-foreground"><span class="ink-label">All writing</span></a>
    </div>
    <div class="flex flex-col gap-5">
      {posts.map((post) => (
        <BlogCard
          headingLevel="h3"
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={toSlug(post.id)}
        />
      ))}
    </div>
  </section>
</Base>
