---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import BlogCard from '../components/BlogCard.astro';
import GitHubActivity from '../components/ui/github-activity';
import CareerLine from '../components/CareerLine.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

export const prerender = false;

const toSlug = (id: string) => id.replace(/\/index$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime() || a.data.title.localeCompare(b.data.title)).slice(0, 4);
---
<Base>
  <link slot="head" rel="preload" href="/api/github/kartik-mem0?resource=calendar" as="fetch" crossorigin="anonymous" />
  <PageHeader title={profile.name} description={profile.tagline} />
  <CareerLine />

  <div class="py-10 lg:py-12">
    <GitHubActivity client:load username="kartik-mem0" />
  </div>

  <section class="flex flex-col gap-4">
    <div class="flex items-baseline justify-between gap-4">
      <p>Writing</p>
      <a href="/blog" class="text-sm text-muted-foreground hover:text-foreground hover:underline">All writing</a>
    </div>
    <div class="flex flex-col gap-4">
      {posts.map((post) => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={toSlug(post.id)}
        />
      ))}
    </div>
  </section>
</Base>
