---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostViews from '../../components/PostViews.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import BlogCard from '../../components/BlogCard.astro';
import { profile } from '../../data/profile';
import { getCollection, render } from 'astro:content';

// On demand so the Accept-negotiation middleware runs (see src/middleware.ts).
export const prerender = false;

const slug = (p: { id: string }) => p.id.replace(/\/index$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime() || a.data.title.localeCompare(b.data.title));
const index = posts.findIndex((p) => slug(p) === Astro.params.slug);
if (index === -1) return Astro.rewrite('/404');
const post = posts[index]!;
const otherPosts = posts.filter((entry) => entry.id !== post.id).slice(0, 2);
const { Content } = await render(post);
const date = post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base
  title={`${post.data.title} | Kartik Labhshetwar`}
  description={post.data.description}
  toc="#prose-content h2, #prose-content h3"
  ogType="article"
  schemaType="BlogPosting"
  datePublished={post.data.pubDate.toISOString()}
  wide
>
  <PageHeader title={post.data.title} description={post.data.description} />

  <article class="page-content">
    <div id="prose-content" class="article-prose">
      <Content />
    </div>
    <div class="mt-8 flex items-center justify-between gap-4">
      <time datetime={post.data.pubDate.toISOString()} class="text-xs text-muted-foreground">Published {date}</time>
      <PostViews slug={slug(post)} />
    </div>
  </article>

  {otherPosts.length > 0 && <nav aria-label="Keep reading" class="mt-8 border-t border-border pt-6">
    <div class="mb-5 flex items-baseline justify-between gap-4">
      <h2 class="text-base font-medium">Keep reading</h2>
      <a href="/blog" class="ink-link shrink-0 text-sm text-muted-foreground"><span class="ink-label">All writing <span aria-hidden="true">→</span></span></a>
    </div>
    <ul class="grid gap-5 sm:grid-cols-2 sm:gap-6">
      {otherPosts.map((entry) => (
        <li>
          <BlogCard headingLevel="h3" title={entry.data.title} description={entry.data.description} pubDate={entry.data.pubDate} slug={slug(entry)} />
        </li>
      ))}
    </ul>
  </nav>}

  <aside class="mt-8 rounded-xl border border-border bg-muted/30 p-4 sm:p-5">
    <h2 class="text-base font-medium">Get the next post in your inbox</h2>
    <p class="mt-1 mb-4 text-sm leading-6 text-muted-foreground">{profile.newsletter}. Notes on building software, sent when a new post goes up.</p>
    <NewsletterForm />
  </aside>
</Base>
